+    /** Wall clock ({@link dev.quire.memory.LightFreezer#clock()}) of the last published update, for the idle test of the freezer. */
+    public int quireLastUpdate = dev.quire.memory.LightFreezer.clock() - (1 << 20); // never updated: long idle
+
+    private static dev.quire.memory.Sparse4096 encode(final byte[] bytes) {
+        final int[] v = new int[4096];
+        for (int i = 0; i < 4096; ++i) {
+            v[i] = (bytes[i >>> 1] >>> ((i & 1) << 2)) & 0xF;
+        }
+        return dev.quire.memory.Sparse4096.encode(v, 4, FREEZE_MAX_BYTES);
+    }
+
+    private static byte[] decode(final dev.quire.memory.Sparse4096 sparse) {
+        final byte[] bytes = new byte[ARRAY_SIZE];
+        for (int i = 0; i < ARRAY_SIZE; ++i) {
+            bytes[i] = (byte)(sparse.get(i << 1) | (sparse.get((i << 1) | 1) << 4));
+        }
+        return bytes;
+    }
+
+    private boolean quireFreezeFailed; // since the last published update
+
+    public boolean isFrozen() {
+        return this.frozen != null;
+    }
+
+    /** Debug: why this nibble is not freezable (0 = freezable). */
+    public int quire$notFreezableReason() {
+        final byte[] data = this.storageVisible;
+        if (this.frozen != null) return 1;
+        if (this.quireFreezeFailed) return 2;
+        if (data == null) return 3;
+        if (isShared(data)) return 4;
+        if (this.stateVisible != INIT_STATE_INIT && this.stateVisible != INIT_STATE_HIDDEN) return 5;
+        if (this.isDirty()) return 6;
+        return 0;
+    }
+
+    /** Racy hint for the freezer. */
+    public boolean quire$freezable() {
+        final byte[] data = this.storageVisible;
+        return FREEZE && !this.quireFreezeFailed && this.frozen == null && data != null && !isShared(data)
+            && (this.stateVisible == INIT_STATE_INIT || this.stateVisible == INIT_STATE_HIDDEN);
+    }
