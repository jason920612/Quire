+    /** The shared array equal to data, or data itself. */
+    private static byte[] dedupe(final byte[] data) {
+        if (data == null || isShared(data) || data.length != ARRAY_SIZE) {
+            return data;
+        }
+        if (isAllZero(data)) {
+            return SHARED_ZERO;
+        }
+        if (isAllFull(data)) {
+            return SHARED_FULL;
+        }
+        return data;
+    }
+    // Quire end - share uniform nibble data
