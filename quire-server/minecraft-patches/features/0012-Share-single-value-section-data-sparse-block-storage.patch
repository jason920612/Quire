+    // Quire start - share uniform nibble data
+    // Over half of all initialised sky light sections are entirely 15 (open sky) or 0 (deep underground).
+    // They point to one read-only array each; every write path copies before writing (copy-on-write
+    // via swapUpdatingAndMarkDirty/allocateBytes), and updateVisible never copies into a shared array.
+    private static final byte[] SHARED_ZERO = new byte[ARRAY_SIZE];
+    private static final byte[] SHARED_FULL = new byte[ARRAY_SIZE];
+    static {
+        Arrays.fill(SHARED_FULL, (byte)-1);
+    }
+
+    private static boolean isShared(final byte[] bytes) {
+        return bytes == SHARED_ZERO || bytes == SHARED_FULL;
+    }
+
+    private static boolean isAllFull(final byte[] data) {
+        final int len = data.length / Long.BYTES;
+        for (int i = 0; i < len; ++i) {
+            if (-1L != (long)LONG_VIEW.get(data, i << 3)) {
+                return false;
+            }
+        }
+        return true;
+    }
