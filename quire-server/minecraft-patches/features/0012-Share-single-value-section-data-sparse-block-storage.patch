+    // operation type: updating
+    public boolean quire$freeze() {
+        if (!FREEZE || this.frozen != null || this.isDirty()) {
+            return false;
+        }
+        synchronized (this) {
+            final byte[] data = this.storageVisible;
+            if ((this.stateVisible != INIT_STATE_INIT && this.stateVisible != INIT_STATE_HIDDEN) || data == null || isShared(data)
+                || this.storageUpdating != data) {
+                return false;
+            }
+            final dev.quire.memory.Sparse4096 sparse = encode(data);
+            if (sparse == null) {
+                this.quireFreezeFailed = true;
+                return false;
+            }
+            if (dev.quire.memory.SectionCompression.VERIFY && !Arrays.equals(decode(sparse), data)) {
+                throw new IllegalStateException("Sparse light encoding mismatch");
+            }
+            // publish the frozen form before dropping the array: visible readers check the array first
+            this.frozen = sparse;
+            this.storageVisible = null;
+            this.storageUpdating = null;
+            return true;
+        }
+    }
+
+    // operation type: updating
+    private void thaw() {
+        synchronized (this) {
+            final dev.quire.memory.Sparse4096 sparse = this.frozen;
+            if (sparse == null) {
+                return;
+            }
+            final byte[] data = decode(sparse);
+            this.storageUpdating = data;
+            this.storageVisible = data; // publish the array before dropping the frozen form
+            this.frozen = null;
+        }
+    }
+
+    /** Visible data as an array (decoded copy when frozen); caller holds the lock. */
+    private byte[] visibleData() {
+        final byte[] data = this.storageVisible;
+        if (data != null) {
+            return data;
+        }
+        final dev.quire.memory.Sparse4096 sparse = this.frozen;
+        return sparse == null ? null : decode(sparse);
+    }
+    // Quire end - frozen light
