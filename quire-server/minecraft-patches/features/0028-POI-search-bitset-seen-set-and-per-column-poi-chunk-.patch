+        // once per search instead of once per section
+        final int boxX = upperX - lowerX + 1, boxY = upperY - lowerY + 1, boxZ = upperZ - lowerZ + 1;
+        final long[] seen = new long[(boxX * boxY * boxZ + 63) >>> 6];
+        final int[] queue = new int[boxX * boxY * boxZ];
+        int queueHead = 0, queueTail = 0;
+        final ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk[] columns = new ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk[boxX * boxZ];
+        final boolean[] columnResolved = new boolean[boxX * boxZ];
+        final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager holderManager =
+            ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)poiStorage.moonrise$getWorld()).moonrise$getChunkTaskScheduler().chunkHolderManager;
+        {
+            final int centerIndex = ((centerY - lowerY) * boxZ + (centerZ - lowerZ)) * boxX + (centerX - lowerX);
+            seen[centerIndex >>> 6] |= 1L << centerIndex;
+            queue[queueTail++] = centerIndex;
+        }
 
-            if (sectionX < lowerX || sectionX > upperX || sectionY < lowerY || sectionY > upperY || sectionZ < lowerZ || sectionZ > upperZ) {
-                // out of bound chunk
-                continue;
-            }
+        while (queueHead < queueTail) {
+            final int index = queue[queueHead++];
+            final int sectionX = lowerX + index % boxX;
+            final int sectionZ = lowerZ + (index / boxX) % boxZ;
+            final int sectionY = lowerY + index / (boxX * boxZ);
 
             final double sectionDistanceSquared = getSmallestDistanceSquared(
                     (double)(sectionX << 4),
@@ -402,16 +409,33 @@ public final class PoiAccess {
                         final int neighbourX = sectionX + dx;
                         final int neighbourY = sectionY + dy;
                         final int neighbourZ = sectionZ + dz;
+                        if (neighbourX < lowerX || neighbourX > upperX || neighbourY < lowerY || neighbourY > upperY || neighbourZ < lowerZ || neighbourZ > upperZ) {
+                            continue; // out of bound chunk
+                        }
 
-                        final long neighbourKey = CoordinateUtils.getChunkSectionKey(neighbourX, neighbourY, neighbourZ);
-                        if (seen.add(neighbourKey)) {
-                            queue.enqueue(neighbourKey);
+                        final int neighbourIndex = ((neighbourY - lowerY) * boxZ + (neighbourZ - lowerZ)) * boxX + (neighbourX - lowerX);
+                        if ((seen[neighbourIndex >>> 6] & (1L << neighbourIndex)) == 0L) {
+                            seen[neighbourIndex >>> 6] |= 1L << neighbourIndex;
+                            queue[queueTail++] = neighbourIndex;
                         }
                     }
                 }
             }
 
-            final Optional<PoiSection> poiSectionOptional = load ? poiStorage.getOrLoad(key) : poiStorage.get(key);
+            // what poiStorage.getOrLoad(key) / get(key) returned, per column
+            final int column = (sectionZ - lowerZ) * boxX + (sectionX - lowerX);
+            if (!columnResolved[column]) {
+                columnResolved[column] = true;
+                ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(poiStorage.moonrise$getWorld(), sectionX, sectionZ, "Accessing poi chunk off-main");
+                ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk poiChunk = holderManager.getPoiChunkIfLoaded(sectionX, sectionZ, true);
+                if (poiChunk == null && load) {
+                    poiChunk = holderManager.loadPoiChunk(sectionX, sectionZ);
+                }
+                columns[column] = poiChunk;
+            }
+            final ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk poiChunk = columns[column];
+            final Optional<PoiSection> poiSectionOptional = poiChunk == null ? Optional.empty() : poiChunk.getSectionForVanilla(sectionY);
+            // Quire end
 
             if (poiSectionOptional == null || !poiSectionOptional.isPresent()) {
                 continue;
diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index 7a9d326719998a5b4ffe544d9b380ddf049a1b09..5828417afc39777c103d5558dde4a7fa4241a895 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -305,19 +305,52 @@ public class Brain<E extends LivingEntity> {
     public List<BehaviorControl<? super E>> getRunningBehaviors() {
         List<BehaviorControl<? super E>> runningBehaviours = new ObjectArrayList<>();
 
-        for (Map<Activity, Set<BehaviorControl<? super E>>> behavioursByActivities : this.availableBehaviorsByPriority.values()) {
-            for (Set<BehaviorControl<? super E>> behaviors : behavioursByActivities.values()) {
-                for (BehaviorControl<? super E> behavior : behaviors) {
-                    if (behavior.getStatus() == Behavior.Status.RUNNING) {
-                        runningBehaviours.add(behavior);
-                    }
-                }
+        // Quire start - flat view, same order as the nested maps
+        final BehaviorControl<? super E>[] behaviors = this.quire$flatBehaviors();
+        for (final BehaviorControl<? super E> behavior : behaviors) {
+            if (behavior.getStatus() == Behavior.Status.RUNNING) {
