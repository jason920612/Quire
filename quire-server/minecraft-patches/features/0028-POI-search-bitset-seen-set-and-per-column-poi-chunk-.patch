+        // Quire start - flat view; the activity is tested once per group, as the nested loops did
+        final BehaviorControl<? super E>[] behaviors = this.quire$flatBehaviors();
+        final Activity[] activities = this.quireFlatActivities;
+        final boolean[] groupStart = this.quireFlatGroupStart;
