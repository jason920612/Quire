         return runningBehaviours;
     }
 
+    // Quire start - the behaviours of availableBehaviorsByPriority flattened in its iteration order (priority, then
+    // activity, then insertion); rebuilt only when behaviours are added or removed
+    private BehaviorControl<? super E> @org.jspecify.annotations.Nullable [] quireFlatBehaviors;
+    private Activity[] quireFlatActivities;
+    private boolean[] quireFlatGroupStart; // first behaviour of a (priority, activity) group
+
+    @SuppressWarnings("unchecked")
+    private BehaviorControl<? super E>[] quire$flatBehaviors() {
+        BehaviorControl<? super E>[] flat = this.quireFlatBehaviors;
+        if (flat != null) {
+            return flat;
+        }
+        final List<BehaviorControl<? super E>> behaviors = new java.util.ArrayList<>();
+        final List<Activity> activities = new java.util.ArrayList<>();
+        final it.unimi.dsi.fastutil.booleans.BooleanArrayList groupStart = new it.unimi.dsi.fastutil.booleans.BooleanArrayList();
+        for (Map<Activity, Set<BehaviorControl<? super E>>> behavioursByActivities : this.availableBehaviorsByPriority.values()) {
+            for (Entry<Activity, Set<BehaviorControl<? super E>>> behavioursForActivity : behavioursByActivities.entrySet()) {
+                boolean first = true;
+                for (BehaviorControl<? super E> behavior : behavioursForActivity.getValue()) {
+                    behaviors.add(behavior);
+                    activities.add(behavioursForActivity.getKey());
+                    groupStart.add(first);
+                    first = false;
+                }
+            }
+        }
+        flat = behaviors.toArray(new BehaviorControl[0]);
+        this.quireFlatActivities = activities.toArray(new Activity[0]);
+        this.quireFlatGroupStart = groupStart.toBooleanArray();
+        this.quireFlatBehaviors = flat;
+        return flat;
+    }
+    // Quire end
+
     public void useDefaultActivity() {
         this.setActiveActivity(this.defaultActivity);
     }
