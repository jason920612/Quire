+        // Quire start - sky bound: blocks from cutY up provably have negative final density; their density is not
+        // computed and the aquifer gets a negative stand-in (above its sampling limit only the sign matters)
+        int cutY = volume.minBlockY() + volume.sizeY();
+        if (dev.quire.worldgen.SkyBound.ENABLED && !noiseChunk.quireBlending) {
+            int proven = dev.quire.worldgen.SkyBound.provenAirFromY(this.settings.value().noiseRouter().finalDensity(), noiseChunk.cachingSamplers(), volume);
+            int floor = aquifer.quire$skipSamplingAboveY() == Integer.MIN_VALUE ? Integer.MIN_VALUE : aquifer.quire$skipSamplingAboveY() + 1;
+            final net.minecraft.world.level.levelgen.structure.BoundingBox beardBox = noiseChunk.quireBeardifier == null ? null : noiseChunk.quireBeardifier.quire$affectedBox();
+            if (beardBox != null) {
+                floor = Math.max(floor, beardBox.maxY() + 1);
+            }
+            // keep the cut on the interpolation grid (cells of 8 blocks from the bottom)
+            int cut = Math.max(proven, floor);
+            int rel = cut - volume.minBlockY();
