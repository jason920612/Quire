From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jason920612 <jasonya2206@gmail.com>
Date: Wed, 30 Sep 2026 17:54:29 +0800
Subject: [PATCH] Prove air above the terrain and skip its density (exact); no
 load-time section encoding

Per chunk, an upper bound of the final density at the interpolation corners
(exact 1D/2D terrain inputs, interval arithmetic for 3D noise, range_choice
branch selection) proves the height above which every block has negative
density; those blocks are not sampled and get the aquifer result of any
negative density there (verify: -Dquire.gen.verify=true). Section and light
encoding no longer run while chunks load (they slowed loading ~20%).

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 65c88f21c27082727405fd0ef414737006261b80..c4aa01cd283d871557b9a45e53d846f3babf99a5 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -313,8 +313,20 @@ public final class RegionizedPlayerChunkLoader {
     }
     // Quire end - view ring release
 
+    private int quireSweepCounter; // Quire - view ring release
+
     public void tick() {
         TickThread.ensureTickThread("Cannot tick player chunk loader async");
+        // Quire start - view ring release: drop players that left without a normal forget (never retain them)
+        if (++this.quireSweepCounter >= 1200 && !this.quireReleasedReceivers.isEmpty()) {
+            this.quireSweepCounter = 0;
+            this.quireReleasedReceivers.values().removeIf(players -> {
+                players.removeIf(player -> player.isRemoved() || player.level() != this.world
+                    || ((ChunkSystemServerPlayer)player).moonrise$getChunkLoader() == null);
+                return players.isEmpty();
+            });
+        }
+        // Quire end
         long currTime = System.nanoTime();
         for (final ServerPlayer player : new java.util.ArrayList<>(this.world.players())) {
             final PlayerChunkLoaderData loader = ((ChunkSystemServerPlayer)player).moonrise$getChunkLoader();
