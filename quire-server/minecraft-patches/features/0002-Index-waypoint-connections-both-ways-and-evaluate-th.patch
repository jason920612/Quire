+    // Quire start - connection index helpers
+    private WaypointTransmitter.@org.jspecify.annotations.Nullable Connection getConnection(final ServerPlayer player, final WaypointTransmitter waypoint) {
+        final Map<WaypointTransmitter, WaypointTransmitter.Connection> row = this.byPlayer.get(player);
+        return row == null ? null : row.get(waypoint);
+    }
+
+    private void putConnection(final ServerPlayer player, final WaypointTransmitter waypoint, final WaypointTransmitter.Connection connection) {
+        this.byPlayer.computeIfAbsent(player, k -> new LinkedHashMap<>()).put(waypoint, connection);
+        this.byWaypoint.computeIfAbsent(waypoint, k -> new LinkedHashMap<>()).put(player, connection);
+    }
+
+    private WaypointTransmitter.@org.jspecify.annotations.Nullable Connection removeConnection(final ServerPlayer player, final WaypointTransmitter waypoint) {
+        final Map<WaypointTransmitter, WaypointTransmitter.Connection> row = this.byPlayer.get(player);
+        if (row == null) {
+            return null;
+        }
+        final WaypointTransmitter.Connection removed = row.remove(waypoint);
+        if (removed == null) {
+            return null;
+        }
+        if (row.isEmpty()) {
+            this.byPlayer.remove(player);
+        }
+        final Map<ServerPlayer, WaypointTransmitter.Connection> column = this.byWaypoint.get(waypoint);
+        if (column != null) {
+            column.remove(player);
+            if (column.isEmpty()) {
+                this.byWaypoint.remove(waypoint);
+            }
+        }
+        return removed;
+    }
+    // Quire end - connection index helpers
+
+    // Quire start - coalesce position-driven updates to once per tick
+    // Entities can change position several times per tick (move packet, collision, tick snap-back); each
+    // change used to re-evaluate every connection of the entity. Only the end-of-tick state reaches clients
+    // (packets are flushed at the end of the tick), so evaluate once, after everything has moved.
+    private final java.util.LinkedHashSet<WaypointTransmitter> quireDirtyWaypoints = new java.util.LinkedHashSet<>();
+    private final java.util.LinkedHashSet<ServerPlayer> quireDirtyPlayers = new java.util.LinkedHashSet<>();
+
+    public void quire$markWaypointMoved(final WaypointTransmitter waypoint) {
+        if (this.locatorBarEnabled) {
+            this.quireDirtyWaypoints.add(waypoint);
+        }
+    }
+
+    public void quire$markPlayerMoved(final ServerPlayer player) {
+        if (this.locatorBarEnabled) {
+            this.quireDirtyPlayers.add(player);
+        }
+    }
+
+    public void quire$flushDirty() {
+        if (!this.quireDirtyWaypoints.isEmpty()) {
+            final WaypointTransmitter[] dirty = this.quireDirtyWaypoints.toArray(new WaypointTransmitter[0]);
+            this.quireDirtyWaypoints.clear();
+            for (final WaypointTransmitter waypoint : dirty) {
+                this.updateWaypoint(waypoint); // no-op unless still tracked
+            }
+        }
+        if (!this.quireDirtyPlayers.isEmpty()) {
+            final ServerPlayer[] dirty = this.quireDirtyPlayers.toArray(new ServerPlayer[0]);
+            this.quireDirtyPlayers.clear();
+            for (final ServerPlayer player : dirty) {
+                if (this.players.contains(player) && !player.isRemoved() && player.isReceivingWaypoints() && player.connection != null) {
+                    this.updatePlayer(player);
+                }
+            }
+        }
+    }
+    // Quire end - coalesce position-driven updates to once per tick
+
     @Override
     public void trackWaypoint(final WaypointTransmitter waypoint) {
         this.waypoints.add(waypoint);
