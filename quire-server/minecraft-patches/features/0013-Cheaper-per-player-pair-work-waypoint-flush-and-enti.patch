@@ -20,12 +20,12 @@ public interface WaypointTransmitter extends Waypoint {
     Waypoint.Icon waypointIcon();
 
     static boolean doesSourceIgnoreReceiver(final LivingEntity source, final ServerPlayer receiver) {
-        if (!receiver.getBukkitEntity().canSee(source.getBukkitEntity())) return true; // Paper - ignore if entity is hidden from player
+        if (!receiver.getBukkitEntity().quire$canSee(source)) return true; // Paper - ignore if entity is hidden from player // Quire - no UUID lookup without overrides
         if (receiver.isSpectator()) {
             return false;
         } else if (!source.isSpectator() && !source.hasIndirectPassenger(receiver)) {
             double broadcastRange = Math.min(
-                source.getAttributeValue(Attributes.WAYPOINT_TRANSMIT_RANGE), receiver.getAttributeValue(Attributes.WAYPOINT_RECEIVE_RANGE)
+                quire$transmitRange(source), quire$receiveRange(receiver) // Quire - attribute values cached per waypoint flush
             );
             return source.distanceToSqr(receiver) >= Mth.square(broadcastRange); // Paper - optimize waypoint distance check by using squared distance
         } else {
@@ -33,6 +33,33 @@ public interface WaypointTransmitter extends Waypoint {
         }
     }
 
+    // Quire start - attribute values cached for the duration of one waypoint flush (nothing changes attributes
+    // during the flush); outside a flush (epoch 0) they are read directly
+    static double quire$transmitRange(final LivingEntity entity) {
+        final int epoch = net.minecraft.server.waypoints.ServerWaypointManager.quireFlushEpoch;
+        if (epoch == 0) {
+            return entity.getAttributeValue(Attributes.WAYPOINT_TRANSMIT_RANGE);
+        }
+        if (entity.quireWaypointTxEpoch != epoch) {
+            entity.quireWaypointTx = entity.getAttributeValue(Attributes.WAYPOINT_TRANSMIT_RANGE);
+            entity.quireWaypointTxEpoch = epoch;
+        }
+        return entity.quireWaypointTx;
+    }
+
+    static double quire$receiveRange(final LivingEntity entity) {
+        final int epoch = net.minecraft.server.waypoints.ServerWaypointManager.quireFlushEpoch;
+        if (epoch == 0) {
+            return entity.getAttributeValue(Attributes.WAYPOINT_RECEIVE_RANGE);
+        }
+        if (entity.quireWaypointRxEpoch != epoch) {
+            entity.quireWaypointRx = entity.getAttributeValue(Attributes.WAYPOINT_RECEIVE_RANGE);
+            entity.quireWaypointRxEpoch = epoch;
+        }
+        return entity.quireWaypointRx;
+    }
+    // Quire end
+
     static boolean isChunkVisible(final ChunkPos chunkPos, final ServerPlayer receiver) {
