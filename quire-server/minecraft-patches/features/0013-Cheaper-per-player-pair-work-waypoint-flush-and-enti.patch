+++ b/net/minecraft/server/waypoints/ServerWaypointManager.java
@@ -80,22 +80,41 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
         }
     }
 
+    /** Non-zero while a flush runs: attribute values read during it are cached per entity (see WaypointTransmitter). */
+    public static int quireFlushEpoch;
+    private static int quireNextEpoch;
+
     public synchronized void quire$flushDirty() {
-        if (!this.quireDirtyWaypoints.isEmpty()) {
-            final WaypointTransmitter[] dirty = this.quireDirtyWaypoints.toArray(new WaypointTransmitter[0]);
-            this.quireDirtyWaypoints.clear();
-            for (final WaypointTransmitter waypoint : dirty) {
-                this.updateWaypoint(waypoint); // no-op unless still tracked
-            }
+        if (this.quireDirtyWaypoints.isEmpty() && this.quireDirtyPlayers.isEmpty()) {
+            return;
         }
-        if (!this.quireDirtyPlayers.isEmpty()) {
-            final ServerPlayer[] dirty = this.quireDirtyPlayers.toArray(new ServerPlayer[0]);
-            this.quireDirtyPlayers.clear();
-            for (final ServerPlayer player : dirty) {
-                if (this.players.contains(player) && !player.isRemoved() && player.isReceivingWaypoints() && player.connection != null) {
-                    this.updatePlayer(player);
+        quireNextEpoch = quireNextEpoch == Integer.MAX_VALUE ? 1 : quireNextEpoch + 1;
+        quireFlushEpoch = quireNextEpoch;
+        try {
+            java.util.Set<WaypointTransmitter> updatedWaypoints = java.util.Collections.emptySet();
+            if (!this.quireDirtyWaypoints.isEmpty()) {
+                final WaypointTransmitter[] dirty = this.quireDirtyWaypoints.toArray(new WaypointTransmitter[0]);
+                this.quireDirtyWaypoints.clear();
+                updatedWaypoints = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>(dirty.length * 2));
+                for (final WaypointTransmitter waypoint : dirty) {
+                    if (this.waypoints.contains(waypoint)) {
+                        updatedWaypoints.add(waypoint);
+                    }
+                    this.updateWaypoint(waypoint); // no-op unless still tracked
+                }
+            }
+            if (!this.quireDirtyPlayers.isEmpty()) {
+                final ServerPlayer[] dirty = this.quireDirtyPlayers.toArray(new ServerPlayer[0]);
+                this.quireDirtyPlayers.clear();
+                for (final ServerPlayer player : dirty) {
+                    if (this.players.contains(player) && !player.isRemoved() && player.isReceivingWaypoints() && player.connection != null) {
+                        // connections to waypoints updated above were just evaluated; evaluating them again changes nothing
+                        this.quire$updatePlayer(player, updatedWaypoints);
+                    }
                 }
             }
+        } finally {
+            quireFlushEpoch = 0;
         }
     }
     // Quire end - coalesce position-driven updates to once per tick
@@ -131,6 +150,10 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
             }
 
             // Same as the live Sets.difference view: re-checked after the updates above
+            // Quire - connections exist only for tracked players, so a full column means nothing is missing
+            final Map<ServerPlayer, WaypointTransmitter.Connection> after = this.byWaypoint.get(waypoint);
+            final int expected = this.players.size() - (waypoint instanceof ServerPlayer self && this.players.contains(self) ? 1 : 0);
+            if (after == null || after.size() != expected)
             for (ServerPlayer player : this.players) {
                 if (this.getConnection(player, waypoint) == null) {
                     this.createConnection(player, waypoint);
@@ -175,6 +198,10 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     }
 
     public void updatePlayer(final ServerPlayer player) {
+        this.quire$updatePlayer(player, java.util.Collections.emptySet()); // Quire
+    }
