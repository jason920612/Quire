         if (!this.locatorBarEnabled) return; // Paper - optimize ServerWaypointManager with locator bar disabled
         // Quire start - snapshot into arrays instead of ImmutableSet.copyOf; same iteration order
         final Map<WaypointTransmitter, WaypointTransmitter.Connection> row = this.byPlayer.get(player);
@@ -188,11 +215,16 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
                 connections[i++] = entry.getValue();
             }
             for (i = 0; i < size; ++i) {
+                if (alreadyUpdated.contains(waypoints[i])) continue; // Quire - evaluated this flush
                 this.updateConnection(player, waypoints[i], connections[i]);
             }
         }
 
         // Same as the live Sets.difference view: re-checked after the updates above
+        // Quire - connections exist only for tracked waypoints, so a full row means nothing is missing
+        final Map<WaypointTransmitter, WaypointTransmitter.Connection> after = this.byPlayer.get(player);
+        final int expected = this.waypoints.size() - (this.waypoints.contains(player) ? 1 : 0);
+        if (after == null || after.size() != expected)
         for (WaypointTransmitter waypoint : this.waypoints) {
             if (this.getConnection(player, waypoint) == null) {
                 this.createConnection(player, waypoint);
