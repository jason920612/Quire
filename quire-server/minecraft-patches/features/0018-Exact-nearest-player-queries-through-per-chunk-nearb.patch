diff --git a/net/minecraft/server/level/ServerEntityGetter.java b/net/minecraft/server/level/ServerEntityGetter.java
index cc6f4e2845ef1e95c765d65f17c8aa1b06652927..1e42e45c8635c8d802b9c33100c68ca259be3c6a 100644
--- a/net/minecraft/server/level/ServerEntityGetter.java
+++ b/net/minecraft/server/level/ServerEntityGetter.java
@@ -16,12 +16,28 @@ public interface ServerEntityGetter extends EntityGetter {
     ServerLevel getLevel();
 
     default @Nullable Player getNearestPlayer(final TargetingConditions targetConditions, final LivingEntity source) {
+        // Quire start - spatial nearest-player query (exact; falls back to the scan)
+        if (this instanceof ServerLevel serverLevel) {
+            final Object quireResult = dev.quire.util.NearestPlayers.nearestTargetable(serverLevel, targetConditions, source, source.getX(), source.getY(), source.getZ());
+            if (quireResult != dev.quire.util.NearestPlayers.NOT_HANDLED) {
+                return (Player)quireResult;
+            }
+        }
+        // Quire end
         return this.getNearestEntity(this.players(), targetConditions, source, source.getX(), source.getY(), source.getZ());
     }
 
     default @Nullable Player getNearestPlayer(
         final TargetingConditions targetConditions, final LivingEntity source, final double x, final double y, final double z
     ) {
+        // Quire start - spatial nearest-player query (exact; falls back to the scan)
+        if (this instanceof ServerLevel serverLevel && source != null) {
+            final Object quireResult = dev.quire.util.NearestPlayers.nearestTargetable(serverLevel, targetConditions, source, x, y, z);
+            if (quireResult != dev.quire.util.NearestPlayers.NOT_HANDLED) {
+                return (Player)quireResult;
+            }
+        }
+        // Quire end
         return this.getNearestEntity(this.players(), targetConditions, source, x, y, z);
     }
 
diff --git a/net/minecraft/world/entity/ai/targeting/TargetingConditions.java b/net/minecraft/world/entity/ai/targeting/TargetingConditions.java
