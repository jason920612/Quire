@@ -56,6 +56,16 @@ public class TargetingConditions {
         return this;
     }
 
+    // Quire start - upper bound of distance(targeter, target) for any target that passes test(), or -1 if unbounded
+    public double quire$maxPassingDistance(final @Nullable LivingEntity targeter) {
+        if (targeter == null || !(this.range > 0.0)) {
+            return -1.0;
+        }
+        // getVisibilityPercent is clamped to [0, 10]
+        return Math.max(this.range * (this.testInvisible ? 10.0 : 1.0), 2.0);
+    }
+    // Quire end
+
     public boolean test(final ServerLevel level, final @Nullable LivingEntity targeter, final LivingEntity target) {
         if (targeter == target) {
