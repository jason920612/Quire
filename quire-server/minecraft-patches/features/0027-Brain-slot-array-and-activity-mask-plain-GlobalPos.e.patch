diff --git a/net/minecraft/world/entity/InsideBlockEffectApplier.java b/net/minecraft/world/entity/InsideBlockEffectApplier.java
index c2f124383be06ae777c1ee7f0820c959c8359f87..552e622ba7dbaa627d9c9b0b89ccaa8b01c939b5 100644
--- a/net/minecraft/world/entity/InsideBlockEffectApplier.java
+++ b/net/minecraft/world/entity/InsideBlockEffectApplier.java
@@ -65,7 +65,13 @@ public interface InsideBlockEffectApplier {
             this.lastStep = -1;
         }
 
+        private boolean quireRecorded; // Quire - anything recorded since the last flush (otherwise flushing moves nothing)
+
         private void flushStep() {
+            if (!this.quireRecorded) {
+                return; // Quire - every list and the map are empty
+            }
+            this.quireRecorded = false;
             for (InsideBlockEffectType type : APPLY_ORDER) {
                 List<Consumer<Entity>> beforeEffects = this.beforeEffectsInStep.get(type);
                 this.finalEffects.addAll(beforeEffects);
@@ -83,16 +89,19 @@ public interface InsideBlockEffectApplier {
         @Override
         public void apply(final InsideBlockEffectType type) {
             this.effectsInStep.put(type, recorded(type)); // Paper - track position inside effect was triggered on
+            this.quireRecorded = true; // Quire
         }
 
         @Override
         public void runBefore(final InsideBlockEffectType type, final Consumer<Entity> effect) {
             this.beforeEffectsInStep.get(type).add(effect);
+            this.quireRecorded = true; // Quire
         }
 
         @Override
         public void runAfter(final InsideBlockEffectType type, final Consumer<Entity> effect) {
             this.afterEffectsInStep.get(type).add(effect);
+            this.quireRecorded = true; // Quire
         }
 
         // Paper start - track position inside effect was triggered on
diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index 2b22bbfac4e324969e7cff368c690ee915d33a66..7a9d326719998a5b4ffe544d9b380ddf049a1b09 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -38,6 +38,7 @@ import org.jspecify.annotations.Nullable;
 public class Brain<E extends LivingEntity> {
     private static final int SCHEDULE_UPDATE_DELAY = 20;
     private final Map<MemoryModuleType<?>, MemorySlot<?>> memories = Maps.newHashMap();
+    private MemorySlot<?>[] quireSlots = new MemorySlot<?>[0]; // Quire - indexed by MemoryModuleType.quireIndex
     private final Map<SensorType<? extends Sensor<? super E>>, Sensor<? super E>> sensors = Maps.newLinkedHashMap();
     private final Map<Integer, Map<Activity, Set<BehaviorControl<? super E>>>> availableBehaviorsByPriority = Maps.newTreeMap();
     private @Nullable EnvironmentAttribute<Activity> schedule;
@@ -45,6 +46,29 @@ public class Brain<E extends LivingEntity> {
     private final Map<Activity, Set<MemoryModuleType<?>>> activityMemoriesToEraseWhenStopped = Maps.newHashMap();
     private Set<Activity> coreActivities = Sets.newHashSet();
     private final Set<Activity> activeActivities = Sets.newHashSet();
+    // Quire start - bit mask mirror of activeActivities (the set only changes in setActiveActivity); -1 = not usable
+    private long quireActiveMask = 0L;
+
+    private void quire$updateActiveMask() {
+        long mask = 0L;
+        for (final Activity active : this.activeActivities) {
+            if (active.quireIndex >= 64) {
+                this.quireActiveMask = -1L;
+                return;
+            }
+            mask |= 1L << active.quireIndex;
+        }
+        this.quireActiveMask = mask;
+    }
+
+    private boolean quire$isActive(final Activity activity) {
+        final long mask = this.quireActiveMask;
+        if (mask == -1L || activity.quireIndex >= 64) {
+            return this.activeActivities.contains(activity);
+        }
+        return (mask & (1L << activity.quireIndex)) != 0L;
+    }
+    // Quire end
     private Activity defaultActivity = Activity.IDLE;
     private long lastScheduleUpdate = -9999L;
 
@@ -102,7 +126,16 @@ public class Brain<E extends LivingEntity> {
     }
 
     private void registerMemory(final MemoryModuleType<?> memoryType) {
-        this.memories.putIfAbsent(memoryType, MemorySlot.create());
+        // Quire start - slot array mirror of the memories map (entries are only ever added, here)
+        final MemorySlot<?> slot = MemorySlot.create();
+        if (this.memories.putIfAbsent(memoryType, slot) == null) {
+            final int index = memoryType.quireIndex;
+            if (index >= this.quireSlots.length) {
+                this.quireSlots = java.util.Arrays.copyOf(this.quireSlots, Math.max(index + 1, this.quireSlots.length * 2));
+            }
+            this.quireSlots[index] = slot;
+        }
+        // Quire end
     }
 
     public Brain() {
@@ -135,7 +168,11 @@ public class Brain<E extends LivingEntity> {
     }
 
     private <T> @Nullable MemorySlot<T> getMemorySlotIfPresent(final MemoryModuleType<T> memoryType) {
-        return (MemorySlot<T>)this.memories.get(memoryType);
+        // Quire start - array lookup, same result as memories.get
+        final int index = memoryType.quireIndex;
+        final MemorySlot<?>[] slots = this.quireSlots;
+        return index < slots.length ? (MemorySlot<T>)slots[index] : null;
+        // Quire end
     }
 
     private <T> MemorySlot<T> getMemorySlot(final MemoryModuleType<T> memoryType) {
@@ -309,6 +346,7 @@ public class Brain<E extends LivingEntity> {
             this.activeActivities.clear();
             this.activeActivities.addAll(this.coreActivities);
             this.activeActivities.add(activity);
+            this.quire$updateActiveMask(); // Quire
         }
     }
 
@@ -379,7 +417,7 @@ public class Brain<E extends LivingEntity> {
     }
 
     public boolean isActive(final Activity activity) {
-        return this.activeActivities.contains(activity);
+        return this.quire$isActive(activity); // Quire - mask
     }
 
     public void tick(final ServerLevel level, final E body) {
@@ -413,7 +451,7 @@ public class Brain<E extends LivingEntity> {
         for (Map<Activity, Set<BehaviorControl<? super E>>> behavioursByActivities : this.availableBehaviorsByPriority.values()) {
             for (Entry<Activity, Set<BehaviorControl<? super E>>> behavioursForActivity : behavioursByActivities.entrySet()) {
                 Activity activity = behavioursForActivity.getKey();
-                if (this.activeActivities.contains(activity)) {
+                if (this.quire$isActive(activity)) { // Quire - mask
                     for (BehaviorControl<? super E> behavior : behavioursForActivity.getValue()) {
                         if (behavior.getStatus() == Behavior.Status.STOPPED) {
                             behavior.tryStart(level, body, time);
