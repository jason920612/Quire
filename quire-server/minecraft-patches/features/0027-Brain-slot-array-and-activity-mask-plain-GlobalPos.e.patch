Subject: [PATCH] Brain slot array and activity mask, plain GlobalPos.equals,
 cached fence/wall tags, no-op effect flush, read-heat and ticking-section
 inflation hooks


diff --git a/net/minecraft/core/GlobalPos.java b/net/minecraft/core/GlobalPos.java
index d09cead678f48f2fa47a55487f3563f9f680d26b..291d029c83a53d981c15817748ee9f85ea78bcdd 100644
--- a/net/minecraft/core/GlobalPos.java
+++ b/net/minecraft/core/GlobalPos.java
@@ -23,6 +23,15 @@ public record GlobalPos(ResourceKey<Level> dimension, BlockPos pos) {
         return new GlobalPos(dimension, pos);
     }
 
+    // Quire start - plain equals (same semantics as the record's: component-wise Objects.equals); the generated one
+    // stayed an un-inlined method handle chain in hot villager job-site comparisons. hashCode is left generated.
+    @Override
+    public boolean equals(final Object obj) {
+        return this == obj || obj instanceof GlobalPos other
+            && java.util.Objects.equals(this.dimension, other.dimension) && java.util.Objects.equals(this.pos, other.pos);
+    }
+    // Quire end
+
     @Override
     public String toString() {
         return this.dimension + " " + this.pos;
