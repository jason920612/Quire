@@ -1802,11 +1803,14 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profiler.push("tick");
 
             try {
+                dev.quire.stats.EventStats.inLevelTick = true; // Quire - event stats
                 level.tick(haveTime);
