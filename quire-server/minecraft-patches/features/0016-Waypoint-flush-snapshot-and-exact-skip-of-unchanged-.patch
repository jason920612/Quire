+    // Quire start - flush snapshot
+    // Per-pair checks used to chase 6-10 scattered objects of the receiver (Bukkit wrapper, visibility map, game
+    // mode, attribute map, position, passengers): memory latency, not arithmetic, dominated. At the start of a flush
+    // the per-player inputs of doesSourceIgnoreReceiver are copied into flat arrays indexed by a stable slot, and
+    // block/chunk connections of player waypoints are evaluated from them. Nothing moves during the flush.
+    private ServerPlayer[] quireSlotPlayers = new ServerPlayer[64];
+    private final it.unimi.dsi.fastutil.ints.IntArrayList quireFreeSlots = new it.unimi.dsi.fastutil.ints.IntArrayList();
+    private int quireSlotCount;
+    private double[] quireX = new double[64], quireY = new double[64], quireZ = new double[64], quireTx = new double[64], quireRx = new double[64];
+    private boolean[] quireSpectator = new boolean[64], quireNoOverrides = new boolean[64], quireVisibleByDefault = new boolean[64], quireHasVehicle = new boolean[64];
+    private boolean quireSnapshotValid;
+    // Quire - true when no pair can be ignored this flush: nobody is a spectator, a passenger, or has hide/show
+    // overrides, everyone is visible by default, and every pair is closer than the smallest range
+    private boolean quireAllClean;
+
+    private void quire$assignSlot(final ServerPlayer player) {
+        if (player.quireWaypointSlot >= 0) {
+            return;
+        }
+        final int slot = this.quireFreeSlots.isEmpty() ? this.quireSlotCount++ : this.quireFreeSlots.popInt();
+        if (slot >= this.quireSlotPlayers.length) {
+            final int n = this.quireSlotPlayers.length * 2;
+            this.quireSlotPlayers = java.util.Arrays.copyOf(this.quireSlotPlayers, n);
+            this.quireX = java.util.Arrays.copyOf(this.quireX, n);
+            this.quireY = java.util.Arrays.copyOf(this.quireY, n);
+            this.quireZ = java.util.Arrays.copyOf(this.quireZ, n);
+            this.quireTx = java.util.Arrays.copyOf(this.quireTx, n);
+            this.quireRx = java.util.Arrays.copyOf(this.quireRx, n);
+            this.quireSpectator = java.util.Arrays.copyOf(this.quireSpectator, n);
+            this.quireNoOverrides = java.util.Arrays.copyOf(this.quireNoOverrides, n);
+            this.quireVisibleByDefault = java.util.Arrays.copyOf(this.quireVisibleByDefault, n);
+            this.quireHasVehicle = java.util.Arrays.copyOf(this.quireHasVehicle, n);
+        }
+        this.quireSlotPlayers[slot] = player;
+        player.quireWaypointSlot = slot;
+    }
+
+    private static void quire$tagConnection(final ServerPlayer receiver, final WaypointTransmitter.Connection connection) {
+        if (connection instanceof WaypointTransmitter.EntityBlockConnection block) {
+            block.quireReceiverSlot = receiver.quireWaypointSlot;
+        } else if (connection instanceof WaypointTransmitter.EntityChunkConnection chunk) {
+            chunk.quireReceiverSlot = receiver.quireWaypointSlot;
+        }
+    }
+
+    private void quire$releaseSlot(final ServerPlayer player) {
+        final int slot = player.quireWaypointSlot;
+        if (slot >= 0 && slot < this.quireSlotPlayers.length && this.quireSlotPlayers[slot] == player) {
+            this.quireSlotPlayers[slot] = null;
+            this.quireFreeSlots.add(slot);
+            player.quireWaypointSlot = -1;
+        }
+    }
+
+    private void quire$takeSnapshot() {
+        for (final ServerPlayer player : this.players) {
+            final int s = player.quireWaypointSlot;
+            if (s < 0) {
+                continue;
+            }
+            this.quireX[s] = player.getX();
+            this.quireY[s] = player.getY();
+            this.quireZ[s] = player.getZ();
+            this.quireTx[s] = player.getAttributeValue(net.minecraft.world.entity.ai.attributes.Attributes.WAYPOINT_TRANSMIT_RANGE);
+            this.quireRx[s] = player.getAttributeValue(net.minecraft.world.entity.ai.attributes.Attributes.WAYPOINT_RECEIVE_RANGE);
+            this.quireSpectator[s] = player.isSpectator();
+            this.quireNoOverrides[s] = player.getBukkitEntity().quire$hasNoVisibilityOverrides();
+            this.quireVisibleByDefault[s] = player.visibleByDefault;
+            this.quireHasVehicle[s] = player.isPassenger();
+        }
+        this.quireSnapshotValid = true;
+        // Quire start - waypoint skip: clean predicate
+        boolean clean = true;
+        double minRange = Double.MAX_VALUE;
+        double minX = Double.MAX_VALUE, minY = Double.MAX_VALUE, minZ = Double.MAX_VALUE;
+        double maxX = -Double.MAX_VALUE, maxY = -Double.MAX_VALUE, maxZ = -Double.MAX_VALUE;
+        for (final ServerPlayer player : this.players) {
+            final int s = player.quireWaypointSlot;
+            if (s < 0 || this.quireSpectator[s] || !this.quireNoOverrides[s] || !this.quireVisibleByDefault[s] || this.quireHasVehicle[s]) {
+                clean = false;
+                break;
+            }
+            minRange = Math.min(minRange, Math.min(this.quireTx[s], this.quireRx[s]));
+            minX = Math.min(minX, this.quireX[s]);
+            minY = Math.min(minY, this.quireY[s]);
+            minZ = Math.min(minZ, this.quireZ[s]);
+            maxX = Math.max(maxX, this.quireX[s]);
+            maxY = Math.max(maxY, this.quireY[s]);
+            maxZ = Math.max(maxZ, this.quireZ[s]);
+        }
+        if (clean && !this.players.isEmpty()) {
+            final double dx = maxX - minX, dy = maxY - minY, dz = maxZ - minZ;
+            // any pair distance^2 <= bounding box diagonal^2 < minRange^2: never ignored for range
+            clean = dx * dx + dy * dy + dz * dz < net.minecraft.util.Mth.square(minRange);
+        }
+        this.quireAllClean = !QUIRE_NO_SKIP && clean && this.waypoints.size() <= this.players.size() && this.quire$onlyPlayerWaypoints();
+        // Quire end - waypoint skip: clean predicate
+    }
+
+    private boolean quire$onlyPlayerWaypoints() {
+        for (final WaypointTransmitter waypoint : this.waypoints) {
+            if (!(waypoint instanceof ServerPlayer)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** WaypointTransmitter.doesSourceIgnoreReceiver for two players with snapshot slots. */
+    private boolean quire$ignores(final ServerPlayer source, final int s, final ServerPlayer receiver, final int r) {
+        if (this.quireNoOverrides[r]) {
+            if (!this.quireVisibleByDefault[s]) {
+                return true; // canSee: source is not the receiver, nothing overridden -> visible by default
+            }
+        } else if (!receiver.getBukkitEntity().quire$canSee(source)) {
+            return true;
+        }
+        if (this.quireSpectator[r]) {
+            return false;
+        }
+        if (this.quireSpectator[s] || (this.quireHasVehicle[r] && source.hasIndirectPassenger(receiver))) {
+            return true;
+        }
+        final double range = Math.min(this.quireTx[s], this.quireRx[r]);
+        final double dx = this.quireX[s] - this.quireX[r];
+        final double dy = this.quireY[s] - this.quireY[r];
+        final double dz = this.quireZ[s] - this.quireZ[r];
+        return dx * dx + dy * dy + dz * dz >= net.minecraft.util.Mth.square(range);
+    }
+
+    /** isBroken() of a block/chunk connection between two players from the snapshot, or -1 if not applicable. */
+    private int quire$fastIsBroken(final ServerPlayer receiver, final WaypointTransmitter waypoint, final WaypointTransmitter.Connection connection) {
+        if (!this.quireSnapshotValid || !(waypoint instanceof ServerPlayer source) || source.quireWaypointSlot < 0) {
+            return -1;
+        }
+        if (connection instanceof WaypointTransmitter.EntityBlockConnection block && block.quireReceiverSlot >= 0) {
+            if (block.distanceManhattan() > 1) {
+                return 1;
+            }
+            return this.quire$ignores(source, source.quireWaypointSlot, receiver, block.quireReceiverSlot) ? 1 : 0;
+        }
+        if (connection instanceof WaypointTransmitter.EntityChunkConnection chunk && chunk.quireReceiverSlot >= 0) {
+            return chunk.quire$isBroken(this.quire$ignores(source, source.quireWaypointSlot, receiver, chunk.quireReceiverSlot)) ? 1 : 0;
+        }
+        return -1;
+    }
+    // Quire end - flush snapshot
+
+    // Quire start - waypoint skip helpers
+    private static final boolean QUIRE_VERIFY = Boolean.getBoolean("quire.waypoints.verify");
+    private static final boolean QUIRE_NO_SKIP = Boolean.getBoolean("quire.waypoints.noSkip");
+    private static final boolean QUIRE_STATS = Boolean.getBoolean("quire.waypoints.stats");
+    private static long QUIRE_SKIPPED, QUIRE_FULL, QUIRE_FLUSHES, QUIRE_CLEAN_FLUSHES, QUIRE_LAST_LOG;
+
+    private void quire$verifySkip(final ServerPlayer source) {
+        final Map<ServerPlayer, WaypointTransmitter.Connection> column = this.byWaypoint.get(source);
+        if (column == null) {
+            return;
+        }
+        for (final Map.Entry<ServerPlayer, WaypointTransmitter.Connection> entry : column.entrySet()) {
+            if (!(entry.getValue() instanceof WaypointTransmitter.EntityBlockConnection block) || block.distanceManhattan() != 0
+                || WaypointTransmitter.doesSourceIgnoreReceiver(source, entry.getKey())) {
+                throw new IllegalStateException("Quire waypoint skip invariant broken for " + source.getScoreboardName() + " -> " + entry.getKey().getScoreboardName() + ": " + entry.getValue());
+            }
+        }
+    }
+
+    private void quire$createMissing(final WaypointTransmitter waypoint) {
+        final Map<ServerPlayer, WaypointTransmitter.Connection> after = this.byWaypoint.get(waypoint);
+        final int expected = this.players.size() - (waypoint instanceof ServerPlayer self && this.players.contains(self) ? 1 : 0);
+        if (after == null || after.size() != expected) {
+            for (ServerPlayer player : this.players) {
+                if (this.getConnection(player, waypoint) == null) {
+                    this.createConnection(player, waypoint);
+                }
+            }
+        }
+    }
+    // Quire end - waypoint skip helpers
