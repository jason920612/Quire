+
+    // Quire start - per category, the players ordered by count (descending, stable): the first of them that a
+    // chunk's player list contains holds the max over that list, usually found within a few membership tests
+    private static final int QUIRE_MAX_PROBES = 32;
+    private final ServerPlayer[][] quireByCount = new ServerPlayer[net.minecraft.world.entity.MobCategory.values().length][];
+    private final int[][] quireCountOrder = new int[net.minecraft.world.entity.MobCategory.values().length][];
+    private final int[] quireOrderSize = new int[net.minecraft.world.entity.MobCategory.values().length];
+    private final int[] quireGlobalEpoch = new int[net.minecraft.world.entity.MobCategory.values().length];
+    private final boolean[] quireGlobalValid = new boolean[net.minecraft.world.entity.MobCategory.values().length];
+    private int quireGlobalMembership;
+
+    /** Max over the list's players of the category's count, or Integer.MIN_VALUE if not answered here. */
+    public int quire$maxCountIfHolderIn(final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> list, final int category) {
+        final ca.spottedleaf.moonrise.common.misc.NearbyPlayers nearby = this.level.moonrise$getNearbyPlayers();
+        if (this.quireGlobalMembership != nearby.quireMembership) {
+            java.util.Arrays.fill(this.quireGlobalValid, false);
+            this.quireGlobalMembership = nearby.quireMembership;
+        }
+        if (!this.quireGlobalValid[category] || this.quireGlobalEpoch[category] != this.quireMobCountEpoch[category]) {
+            this.quire$orderByCount(nearby.quire$players(), category);
+            this.quireGlobalEpoch[category] = this.quireMobCountEpoch[category];
+            this.quireGlobalValid[category] = true;
+        }
+        final ServerPlayer[] order = this.quireByCount[category];
+        final int[] counts = this.quireCountOrder[category];
+        for (int k = 0, n = Math.min(this.quireOrderSize[category], QUIRE_MAX_PROBES); k < n; ++k) {
+            if (list.contains(order[k])) {
+                return counts[k];
+            }
+        }
+        return Integer.MIN_VALUE;
+    }
+
+    private void quire$orderByCount(final java.util.Set<ServerPlayer> players, final int category) {
+        final int n = players.size();
+        ServerPlayer[] order = this.quireByCount[category];
+        if (order == null || order.length < n) {
+            order = this.quireByCount[category] = new ServerPlayer[Math.max(16, n + (n >> 1))];
+            this.quireCountOrder[category] = new int[order.length];
+        }
+        java.util.Arrays.fill(order, null);
+        final int[] counts = this.quireCountOrder[category];
+        final ServerPlayer[] all = players.toArray(new ServerPlayer[0]);
+        final int[] values = new int[all.length];
+        int max = 0;
+        for (int i = 0; i < all.length; ++i) {
+            values[i] = all[i].mobCounts[category] + all[i].mobBackoffCounts[category];
+            max = Math.max(max, values[i]);
+        }
+        if (max > 4096) { // not a small range: comparison sort
+            final Integer[] idx = new Integer[all.length];
+            for (int i = 0; i < idx.length; ++i) idx[i] = i;
+            java.util.Arrays.sort(idx, (a, c) -> Integer.compare(values[c], values[a]));
+            for (int i = 0; i < idx.length; ++i) {
+                order[i] = all[idx[i]];
+                counts[i] = values[idx[i]];
+            }
+        } else { // counting sort, descending
+            final int[] start = new int[max + 2];
+            for (final int v : values) ++start[max - v + 1];
+            for (int v = 1; v < start.length; ++v) start[v] += start[v - 1];
+            for (int i = 0; i < all.length; ++i) {
+                final int at = start[max - values[i]]++;
+                order[at] = all[i];
+                counts[at] = values[i];
+            }
+        }
+        this.quireOrderSize[category] = all.length;
+    }
+    // Quire end
