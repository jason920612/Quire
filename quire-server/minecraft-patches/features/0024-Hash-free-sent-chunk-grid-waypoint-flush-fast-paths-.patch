     private Ticket[] tickets;
     private int size;
+    // Quire start - timed ticket index: the tickets with a timeout, in set order, so expiry does not visit the
+    // (often hundreds of per-player) tickets without one. A ticket's timeout presence never changes while in the set.
+    private static final Ticket[] NO_TICKETS = new Ticket[0];
+    private Ticket[] timed = NO_TICKETS;
+    private int timedSize;
+
+    private static boolean isTimed(final Ticket ticket) {
+        return ((ChunkSystemTicket<?>)(Object)ticket).moonrise$getRemoveDelay() != Long.MIN_VALUE; // ChunkHolderManager.NO_TIMEOUT_MARKER
+    }
+
+    private void timedAdd(final Ticket ticket) {
+        final int index = ~binarySearch(this.timed, 0, this.timedSize, ticket);
+        if (this.timedSize == this.timed.length) {
+            this.timed = Arrays.copyOf(this.timed, Math.max(4, this.timedSize * 2));
+        }
+        System.arraycopy(this.timed, index, this.timed, index + 1, this.timedSize - index);
+        this.timed[index] = ticket;
+        ++this.timedSize;
+    }
+
+    private void timedRemove(final Ticket ticket) {
+        final int index = binarySearch(this.timed, 0, this.timedSize, ticket);
+        System.arraycopy(this.timed, index + 1, this.timed, index, --this.timedSize - index);
+        this.timed[this.timedSize] = null;
+    }
+    // Quire end - timed ticket index
 
     public TicketSet(final int initialCapacity) {
         this.tickets = new Ticket[initialCapacity];
@@ -83,9 +109,11 @@ public final class TicketSet extends AbstractSet<Ticket> {
 
         ++this.size;
         this.tickets[index] = ticket;
+        if (isTimed(ticket)) this.timedAdd(ticket); // Quire - timed ticket index
     }
 
     private void removeAt(final int index) {
+        if (isTimed(this.tickets[index])) this.timedRemove(this.tickets[index]); // Quire - timed ticket index
         if (index != --this.size) {
             System.arraycopy(this.tickets, index + 1, this.tickets, index, this.size - index);
         }
@@ -95,7 +123,10 @@ public final class TicketSet extends AbstractSet<Ticket> {
 
     public TicketSet copy() {
         final int size = this.size;
-        return new TicketSet(Arrays.copyOf(this.tickets, size), size);
+        final TicketSet copy = new TicketSet(Arrays.copyOf(this.tickets, size), size);
+        copy.timed = Arrays.copyOf(this.timed, this.timedSize); // Quire - timed ticket index
+        copy.timedSize = this.timedSize;
+        return copy;
     }
 
