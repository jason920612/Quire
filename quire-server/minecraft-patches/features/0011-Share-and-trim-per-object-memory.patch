+    // Quire start - share template positions: cached templates hold hundreds of thousands of small relative
+    // positions, mostly the same few thousand values; BlockPos is immutable
+    private static final int QUIRE_POS_BITS = 6;
+    private static final BlockPos[] QUIRE_POS_CACHE = new BlockPos[1 << (3 * QUIRE_POS_BITS)];
+
+    private static BlockPos quire$internPos(final int x, final int y, final int z) {
+        final int limit = 1 << QUIRE_POS_BITS;
+        if (x < 0 || y < 0 || z < 0 || x >= limit || y >= limit || z >= limit) {
+            return new BlockPos(x, y, z);
+        }
+        final int index = (((y << QUIRE_POS_BITS) | z) << QUIRE_POS_BITS) | x;
+        BlockPos pos = QUIRE_POS_CACHE[index];
+        if (pos == null) {
+            QUIRE_POS_CACHE[index] = pos = new BlockPos(x, y, z); // benign race: any instance is equal
+        }
+        return pos;
+    }
+    // Quire end - share template positions
+
