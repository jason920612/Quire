             return true;
         } else {
             return false;
@@ -104,11 +198,12 @@ public class AdvancementProgress implements Comparable<AdvancementProgress> {
 
     @Override
     public String toString() {
-        return "AdvancementProgress{criteria=" + this.criteria + ", requirements=" + this.requirements + "}";
