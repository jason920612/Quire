From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jason920612 <jasonya2206@gmail.com>
Date: Wed, 30 Sep 2026 15:10:46 +0800
Subject: [PATCH] Visibility checks without UUID lookups when nothing is
 overridden


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index f11ad0f2cdbb128dfa1f572903ad1b16b80c3e87..b9e70251a44f64fb083986e924ba286cd3985c31 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2067,6 +2067,22 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
         return this.equals(entity) || entity.isVisibleByDefault() ^ this.invertedVisibilityEntities.containsKey(entity.getUniqueId()); // SPIGOT-7312: Can always see self
     }
 
+    // Quire start - same result as canSee(entity.getBukkitEntity()) without the UUID map lookup when nothing is overridden
+    public boolean quire$hasNoVisibilityOverrides() {
+        return this.invertedVisibilityEntities.isEmpty();
+    }
+
+    public boolean quire$canSee(final net.minecraft.world.entity.Entity entity) {
+        if (entity == this.getHandle()) {
+            return true;
+        }
+        if (this.invertedVisibilityEntities.isEmpty()) {
+            return entity.visibleByDefault;
+        }
+        return this.canSee(entity.getBukkitEntity());
+    }
+    // Quire end
+
     public boolean canSeePlayer(UUID uuid) {
         org.bukkit.entity.Entity entity = this.getServer().getPlayer(uuid);
 
